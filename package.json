{
  "name": "thai-test-data-monorepo",
  "private": true,
  "description": "Thai Test Data: library (packages/thai-test-data) and web app (apps/web)",
  "license": "MIT",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm run build -w thai-test-data",
    "build:web": "npm run build -w @thai-test-data/web",
    "build:data": "npm run build:data -w thai-test-data --",
    "dev": "npm run dev -w @thai-test-data/web",
    "test": "npm test -w thai-test-data",
    "test:web": "npm test -w @thai-test-data/web",
    "typecheck": "npm run typecheck -w thai-test-data"
  }
}
